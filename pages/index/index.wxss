/** index 引导页样式 **/
.intro-page {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.intro-hero {
  margin-top: 16rpx;
}

.intro-logo {
  font-size: 48rpx;
  font-weight: 700;
  color: #2F6E9E;
  margin-bottom: 16rpx;
}

.theme--dark .intro-logo {
  color: rgba(79, 182, 178, 0.95);
}

.intro-subtitle {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.theme--dark .intro-subtitle {
  color: rgba(255, 255, 255, 0.72);
}

.intro-privacy {
  font-size: 24rpx;
}

.intro-input {
  margin-top: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background-color: #F7F5F2;
  font-size: 28rpx;
}

.storage-group {
  margin-top: 24rpx;
}

.storage-option {
  display: block;
  padding: 20rpx 0;
}

.storage-main {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.storage-texts {
  margin-left: 16rpx;
}

.storage-title {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.storage-desc {
  max-width: 520rpx;
}

.intro-footer {
  margin-top: auto;
}
