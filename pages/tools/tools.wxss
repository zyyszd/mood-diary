.tools-page {
}

.tool-card {
  margin-top: 16rpx;
}

.breath-circle {
  margin: 16rpx auto 12rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #E2F4F3 0%, #F7F5F2 70%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.breath-inner {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background-color: #4FB6B2;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  text-align: center;
  padding: 10rpx;
  box-sizing: border-box;
  transition: all 1.2s ease-in-out;
}

.breath-inner.inhale {
  transform: scale(1.1);
}

.breath-inner.exhale {
  transform: scale(0.9);
  background-color: #2F6E9E;
}

.breath-inner.hold {
  transform: scale(1.0);
}

.affirmation-text {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.tool-actions {
  margin-top: 16rpx;
}

.secondary-btn.small {
  width: auto;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
}
